{
  "name": "leny-lima",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gustavolimalx/leny-lima"
  },
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": "22.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "preinstall": "pnpm audit --audit-level=high",
    "prebuild": "node generate-sitemap.mjs && pnpm audit --audit-level=high",
    "ng": "node -r dotenv/config ./node_modules/@angular/cli/bin/ng.js",
    "start": "node -r dotenv/config ./node_modules/@angular/cli/bin/ng.js serve",
    "build": "node -r dotenv/config ./node_modules/@angular/cli/bin/ng.js build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr": "node dist/leny-lima/server/server.mjs",
    "images:webp": "node convert-images.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@angular/forms": "^20.3.25",
    "@angular/platform-browser": "^20.3.25",
    "@angular/platform-server": "^20.3.27",
    "@angular/router": "^20.3.25",
    "@angular/ssr": "^20.3.29",
    "@tailwindcss/postcss": "^4.3.1",
    "daisyui": "^5.5.23",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.29",
    "@angular/cli": "^20.3.29",
    "@angular/compiler-cli": "^20.3.25",
    "@ngx-env/builder": "^20.1.1",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^20.19.43",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3"
  }
}
